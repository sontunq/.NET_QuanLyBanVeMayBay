<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Chương trình báo cáo Crystal Reports.
    Crystal Reports chỉ chạy trên .NET Framework nên tách thành project riêng (net48),
    ứng dụng chính (.NET 8) gọi BaoCao.exe và truyền tham số.
    Máy chạy cần cài "SAP Crystal Reports runtime engine for .NET Framework" (64-bit).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BaoCao</RootNamespace>
    <AssemblyName>BaoCao</AssemblyName>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <CrystalGac>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL</CrystalGac>
    <CrystalVer>v4.0_13.0.4000.0__692fbea5521e1304</CrystalVer>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="CrystalDecisions.CrystalReports.Engine">
      <HintPath>$(CrystalGac)\CrystalDecisions.CrystalReports.Engine\$(CrystalVer)\CrystalDecisions.CrystalReports.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.Shared">
      <HintPath>$(CrystalGac)\CrystalDecisions.Shared\$(CrystalVer)\CrystalDecisions.Shared.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportSource">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportSource\$(CrystalVer)\CrystalDecisions.ReportSource.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.Windows.Forms">
      <HintPath>$(CrystalGac)\CrystalDecisions.Windows.Forms\$(CrystalVer)\CrystalDecisions.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.ClientDoc">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportAppServer.ClientDoc\$(CrystalVer)\CrystalDecisions.ReportAppServer.ClientDoc.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.Controllers">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportAppServer.Controllers\$(CrystalVer)\CrystalDecisions.ReportAppServer.Controllers.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.ReportDefModel">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportAppServer.ReportDefModel\$(CrystalVer)\CrystalDecisions.ReportAppServer.ReportDefModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.DataDefModel">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportAppServer.DataDefModel\$(CrystalVer)\CrystalDecisions.ReportAppServer.DataDefModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.DataSetConversion">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportAppServer.DataSetConversion\$(CrystalVer)\CrystalDecisions.ReportAppServer.DataSetConversion.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CrystalDecisions.ReportAppServer.CommonObjectModel">
      <HintPath>$(CrystalGac)\CrystalDecisions.ReportAppServer.CommonObjectModel\$(CrystalVer)\CrystalDecisions.ReportAppServer.CommonObjectModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Mẫu báo cáo (.rpt) được chép ra cạnh BaoCao.exe -->
  <ItemGroup>
    <None Update="Mau\*.rpt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
